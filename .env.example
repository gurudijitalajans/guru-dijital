# Guru Panel (Payload CMS) ayarları. Kopyalayıp .env.local olarak doldurun.
# Rastgele uzun bir değer: openssl rand -hex 32
PAYLOAD_SECRET=
# Yerel geliştirme: SQLite dosyası. Canlıda Guru'ya ait Postgres bağlantısı gelecek.
DATABASE_URL=file:./data/guru.db
# Sitenin tam adresi (yerelde boş bırakılabilir)
NEXT_PUBLIC_SERVER_URL=
# npm run seed ile oluşturulan ilk yönetici hesabı (yalnız yerel test için)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
