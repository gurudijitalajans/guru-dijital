# Guru Panel (Payload CMS) ayarları. Kopyalayıp .env.local olarak doldurun.
# Rastgele uzun bir değer: openssl rand -hex 32
PAYLOAD_SECRET=
# Yerel geliştirme: SQLite dosyası. Canlıda Guru'ya ait Postgres bağlantısı gelecek.
DATABASE_URL=file:./data/guru.db
# Sitenin tam adresi (yerelde boş bırakılabilir)
NEXT_PUBLIC_SERVER_URL=
# npm run seed ile oluşturulan ilk yönetici hesabı (yalnız yerel test için)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Ziyaretçi analizi (Umami). Site kimliği ve betik adresi panelde: Site Ayarları > Ziyaretçi analizi.
# Panel istatistikleri için API bağlantısı (gizli bilgiler yalnız burada tutulur):
#   Umami Cloud:        UMAMI_API_URL=https://api.umami.is/v1 ve UMAMI_API_KEY
#   Kendi sunucunuz:    UMAMI_API_URL=https://analiz.alanadiniz.com/api ve UMAMI_API_KEY
#                       (ya da UMAMI_USERNAME + UMAMI_PASSWORD)
UMAMI_API_URL=
UMAMI_API_KEY=
UMAMI_USERNAME=
UMAMI_PASSWORD=
